{
  "name": "nexus-portal",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @nexus/web",
    "dev:server": "npm run dev -w @nexus/server",
    "build": "npm run build -w @nexus/web && npm run build -w @nexus/server",
    "start": "npm run start -w @nexus/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "npm run build && playwright test"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
