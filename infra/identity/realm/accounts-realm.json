{
  "realm": "accounts",
  "displayName": "账号中心",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "rememberMe": false,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 8,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(10) and notUsername and notEmail and passwordHistory(3)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 604800,
  "ssoSessionMaxLifespan": 2592000,
  "actionTokenGeneratedByUserLifespan": 900,
  "attributes": {
    "actionTokenGeneratedByUserLifespan.verify-email": "1800",
    "actionTokenGeneratedByUserLifespan.reset-credentials": "900",
    "actionTokenGeneratedByUserLifespan.update-email": "1800"
  },
  "internationalizationEnabled": true,
  "supportedLocales": ["zh-CN", "en"],
  "defaultLocale": "zh-CN",
  "localizationTexts": {
    "zh-CN": {
      "deviceActivity": "网页登录",
      "signedInDevices": "已登录的浏览器",
      "signedInDevicesExplanation": "这里只有浏览器里的账号中心登录（LiteSync、Nexus 的网页靠它免密进入）。已连接的 Obsidian 与浏览器扩展不在这里：Obsidian 在 LiteSync「账号与设备」里管理，扩展在 Nexus「设置 › 数据、同步与安全」里管理。要一次断开全部，请在任一产品里点「退出所有产品与设备」。",
      "signOutAllDevices": "退出所有浏览器",
      "signOutAllDevicesWarning": "这会结束你在所有浏览器里的账号中心登录（包括现在这个），LiteSync 与 Nexus 的网页随之退出。已连接的 Obsidian 与浏览器扩展不受影响；要断开它们，请在 LiteSync 或 Nexus 里点「退出所有产品与设备」。"
    },
    "en": {
      "deviceActivity": "Browser sign-ins",
      "signedInDevices": "Signed-in browsers",
      "signedInDevicesExplanation": "Only browser sign-ins to this account center are listed here (they let the LiteSync and Nexus web apps open without a password). Connected Obsidian devices and browser extensions are not listed: manage Obsidian in LiteSync (账号与设备) and extensions in Nexus (设置 › 数据、同步与安全). To disconnect everything at once, use 退出所有产品与设备 (sign out of all products and devices) in either product.",
      "signOutAllDevices": "Sign out all browsers",
      "signOutAllDevicesWarning": "This ends your account-center sign-ins in every browser, including this one, and signs you out of the LiteSync and Nexus web apps. Connected Obsidian devices and browser extensions are not affected; to disconnect them, use 退出所有产品与设备 in LiteSync or Nexus."
    }
  },
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "enabledEventTypes": ["LOGIN", "LOGIN_ERROR", "REGISTER", "REGISTER_ERROR", "LOGOUT", "VERIFY_EMAIL", "SEND_VERIFY_EMAIL", "RESET_PASSWORD", "SEND_RESET_PASSWORD", "UPDATE_EMAIL", "UPDATE_PASSWORD", "REMOVE_TOTP", "UPDATE_TOTP", "DELETE_ACCOUNT"],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "smtpServer": {
    "host": "${SMTP_HOST}",
    "port": "${SMTP_PORT}",
    "from": "${SMTP_FROM}",
    "fromDisplayName": "${SMTP_FROM_NAME}",
    "replyTo": "${SMTP_REPLY_TO}",
    "auth": "true",
    "user": "${SMTP_USER}",
    "password": "${SMTP_PASSWORD}",
    "starttls": "true",
    "ssl": "false"
  },
  "clients": [
    {
      "clientId": "nexus-web",
      "name": "Nexus Portal",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${NEXUS_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "rootUrl": "${NEXUS_PUBLIC_URL}",
      "baseUrl": "${NEXUS_PUBLIC_URL}/",
      "redirectUris": ["${NEXUS_PUBLIC_URL}/auth/callback"],
      "webOrigins": ["${NEXUS_PUBLIC_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${NEXUS_PUBLIC_URL}/",
        "backchannel.logout.url": "${NEXUS_PUBLIC_URL}/auth/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "use.refresh.tokens": "true",
        "id.token.signed.response.alg": "RS256"
      },
      "defaultClientScopes": ["web-origins", "acr", "basic", "profile", "email", "roles"],
      "optionalClientScopes": []
    },
    {
      "clientId": "litesync-web",
      "name": "LiteSync",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${LITESYNC_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "rootUrl": "${LITESYNC_PUBLIC_URL}",
      "baseUrl": "${LITESYNC_PUBLIC_URL}/",
      "redirectUris": ["${LITESYNC_PUBLIC_URL}/auth/callback"],
      "webOrigins": ["${LITESYNC_PUBLIC_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${LITESYNC_PUBLIC_URL}/",
        "backchannel.logout.url": "${LITESYNC_PUBLIC_URL}/auth/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "use.refresh.tokens": "true",
        "id.token.signed.response.alg": "RS256"
      },
      "defaultClientScopes": ["web-origins", "acr", "basic", "profile", "email", "roles"],
      "optionalClientScopes": []
    }
  ],
  "clientScopeMappings": {
    "account": [
      { "client": "nexus-web", "roles": ["manage-account"] },
      { "client": "litesync-web", "roles": ["manage-account"] }
    ],
    "realm-management": [
      { "client": "nexus-web", "roles": ["view-users"] },
      { "client": "litesync-web", "roles": ["view-users"] }
    ]
  },
  "users": [
    {
      "username": "service-account-nexus-web",
      "enabled": true,
      "serviceAccountClientId": "nexus-web",
      "clientRoles": { "realm-management": ["view-users"] }
    },
    {
      "username": "service-account-litesync-web",
      "enabled": true,
      "serviceAccountClientId": "litesync-web",
      "clientRoles": { "realm-management": ["view-users"] }
    }
  ]
}
