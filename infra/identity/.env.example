# 统一身份与共享数据库的配置。复制为 .env（chmod 600）后填写；.env 含密钥，切勿提交。
# 生成随机值：openssl rand -base64 32

# ── 对外地址（都必须是 https，由同一台机器上的反向代理终结 TLS）───────────
ACCOUNTS_PUBLIC_URL=https://accounts.example.com
NEXUS_PUBLIC_URL=https://home.example.com
LITESYNC_PUBLIC_URL=https://sync.example.com

# ── PostgreSQL（一个实例，三个库三个角色，互不可连）─────────────────────────
POSTGRES_SUPERUSER_PASSWORD=
KEYCLOAK_DB_PASSWORD=
NEXUS_DB_PASSWORD=
# 预留给 LiteSync 元数据迁移（批次 G）
LITESYNC_DB_PASSWORD=
# POSTGRES_PORT=5432

# ── Keycloak ──────────────────────────────────────────────────────────────
KEYCLOAK_BOOTSTRAP_ADMIN=temp-admin
KEYCLOAK_BOOTSTRAP_PASSWORD=
# KEYCLOAK_PORT=8180

# 两个产品各自的 OIDC client secret（同样的值要写进各产品自己的配置）：
#   Nexus：    NEXUS_OIDC_CLIENT_SECRET
#   LiteSync： OBSYNC_OIDC_CLIENT_SECRET
NEXUS_OIDC_CLIENT_SECRET=
LITESYNC_OIDC_CLIENT_SECRET=

# ── 身份邮件（注册验证、找回密码、换邮箱）—— 由 Keycloak 通过事务邮件服务商的 SMTP 发出 ──
# 例：Resend 的 SMTP（host smtp.resend.com，port 587，user resend，password = API Key）。
# 留空则不发信：注册后无法完成邮箱验证，公开注册前必须配置并实测投递。
SMTP_HOST=
SMTP_PORT=587
# 加密方式：starttls（587）/ ssl（465）；留空按端口自动选择。首次导入固定为 starttls，之后用 ./configure.sh smtp 修改
SMTP_SECURITY=
SMTP_USER=
SMTP_PASSWORD=
# 使用独立发信子域（已在服务商处验证 SPF / DKIM，并配置 DMARC）
SMTP_FROM=no-reply@mail.accounts.example.com
SMTP_FROM_NAME=账号中心
SMTP_REPLY_TO=support@example.com
